<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug-only, isolated view harness; no privileged actions. Never included in release. -->
        <activity android:name=".OverlayRenderPreviewActivity" android:exported="true" />
        <!-- Debug-only scenario harness: only adb shell (DUMP holder) can send it. -->
        <receiver android:name=".DebugVoiceInjectReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.mist.connect.hermeslab.DEBUG_INJECT_UTTERANCE" /></intent-filter>
        </receiver>
    </application>
</manifest>
