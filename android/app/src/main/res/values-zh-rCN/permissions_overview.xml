<resources>
    <string name="permission_overview_title">权限与检测到的状态</string>
    <string name="permission_overview_intro">引导设置会打开 Android 权限页面，是否允许由你决定。无障碍功能可以读取屏幕内容并执行你请求的手机操作；悬浮文字可能被身边的人看到。</string>
    <string name="permission_overview_initial">尚未开始设置。已读取本设备的状态。</string>
    <string name="permission_overview_in_progress">引导设置进行中。从每个系统页面返回后继续。</string>
    <string name="permission_overview_finished">本次设置已结束。请查看下方各项状态；如需重试请再点一次。</string>
    <string name="permission_overview_interrupted">之前的设置被中断。未再次请求；请检查状态，点“开始”重试。</string>
    <string name="permission_overview_refreshed">已重新读取状态，未请求任何权限。</string>
    <string name="permission_overview_microphone_returned">系统响应后已重新读取麦克风权限。</string>
    <string name="permission_overview_notifications_returned">系统响应后已重新读取通知权限。</string>
    <string name="permission_overview_permission_denied">系统权限仍被拒绝或无法检测。可以继续其他步骤；稍后再点“开始”重试。</string>
    <string name="permission_overview_settings_returned">已从系统设置返回，并重新读取实际设置。仅打开页面不等于已授权。</string>
    <string name="permission_overview_settings_unavailable">该系统设置页面不可用。其他步骤继续；稍后请手动重试。</string>
    <string name="permission_overview_request_failed">无法打开系统请求。不视为已授权；其他步骤继续。</string>
    <string name="permission_overview_start">设置权限</string>
    <string name="permission_overview_show_details">显示详情</string>
    <string name="permission_overview_hide_details">隐藏详情</string>
    <string name="permission_overview_refresh">刷新检测状态</string>
    <string name="permission_overview_row">%1$s：%2$s</string>
    <string name="permission_overview_not_observed">尚未检测</string>
    <string name="permission_overview_not_applicable">此 Android 版本无需此项</string>
    <string name="permission_overview_denied">已拒绝或未启用</string>
    <string name="permission_overview_granted">系统已允许</string>
    <string name="permission_overview_off">关</string>
    <string name="permission_overview_on">开</string>
    <string name="permission_overview_allowed_disconnected">已允许，服务未连接</string>
    <string name="permission_overview_instance_observed">已检测到服务实例；未测试操作</string>
    <string name="permission_overview_stopped">未检测到服务实例</string>
    <string name="permission_overview_microphone">麦克风权限</string>
    <string name="permission_overview_microphone_why">仅在你另行启动语音时用于录音。此页面不会录音。</string>
    <string name="permission_overview_notification_runtime">通知运行时权限</string>
    <string name="permission_overview_notifications_why">Android 13 及以上在应用发送通知前会询问。更早版本无需此提示。</string>
    <string name="permission_overview_notification_delivery">通知已启用</string>
    <string name="permission_overview_notifications_delivery_why">通知权限与通知启用是两个独立的系统信号，都不能证明通知已送达。</string>
    <string name="permission_overview_accessibility_os">已允许应用无障碍服务</string>
    <string name="permission_overview_accessibility_why">在 Android 设置中启用此应用服务后可辅助控制手机。需由你选择；此页面不执行任何操作。</string>
    <string name="permission_overview_accessibility_instance">无障碍服务连接</string>
    <string name="permission_overview_accessibility_instance_why">运行中的实例与系统授权分开检测，不能证明手机操作已成功。</string>
    <string name="permission_overview_overlay_os">已允许显示在其他应用上层</string>
    <string name="permission_overview_overlay_why">用于悬浮状态显示的可选项，仅用语音时不需要。在 Android 设置中由你决定。</string>
    <string name="permission_overview_overlay_optin">应用悬浮显示选项</string>
    <string name="permission_overview_overlay_optin_why">应用偏好与 Android 悬浮窗权限相互独立。此页面不会开启它，也不会显示悬浮窗。</string>
    <string name="permission_overview_handsfree_optin">语音聆听服务</string>
    <string name="permission_overview_handsfree_why">聆听服务是否报告自身处于活动状态。这不能证明请求或语音回答已成功。</string>
    <string name="permission_overview_control_consent">应用控制同意</string>
    <string name="permission_overview_control_why">已保存的应用同意与无障碍授权相互独立。此页面不会更改。</string>
    <string name="permission_overview_mcp_instance">MCP 服务实例</string>
    <string name="permission_overview_mcp_why">服务实例存在只是生命周期上的观察，不能证明 MCP 正常运行或已授权。</string>
    <string name="permission_overview_limit">此处不会执行录音、MCP 命令、无障碍操作或悬浮显示。权限和实例存在都不能证明端到端成功。</string>
    <string name="permission_overview_integration">开始引导设置</string>
</resources>
