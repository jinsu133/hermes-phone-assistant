<resources>
    <string name="permission_overview_title">權限與偵測到的狀態</string>
    <string name="permission_overview_intro">引導設定會開啟 Android 權限畫面，是否允許由你決定。無障礙功能可以讀取螢幕內容並執行你要求的手機操作；浮動文字可能被身邊的人看到。</string>
    <string name="permission_overview_initial">尚未開始設定。已讀取這部裝置的狀態。</string>
    <string name="permission_overview_in_progress">引導設定進行中。從每個系統畫面返回後繼續。</string>
    <string name="permission_overview_finished">本次設定已結束。請查看下方各項狀態；如需重試請再點一次。</string>
    <string name="permission_overview_interrupted">先前的設定已中斷。未再次要求；請檢查狀態，點「開始」重試。</string>
    <string name="permission_overview_refreshed">已重新讀取狀態，未要求任何權限。</string>
    <string name="permission_overview_microphone_returned">系統回應後已重新讀取麥克風權限。</string>
    <string name="permission_overview_notifications_returned">系統回應後已重新讀取通知權限。</string>
    <string name="permission_overview_permission_denied">系統權限仍遭拒絕或無法偵測。可以繼續其他步驟；稍後再點「開始」重試。</string>
    <string name="permission_overview_settings_returned">已從系統設定返回，並重新讀取實際設定。僅開啟畫面不代表已授權。</string>
    <string name="permission_overview_settings_unavailable">無法使用此系統設定畫面。其他步驟繼續；稍後請手動重試。</string>
    <string name="permission_overview_request_failed">無法開啟系統要求。不視為已授權；其他步驟繼續。</string>
    <string name="permission_overview_start">設定權限</string>
    <string name="permission_overview_show_details">顯示詳細資料</string>
    <string name="permission_overview_hide_details">隱藏詳細資料</string>
    <string name="permission_overview_refresh">重新整理偵測狀態</string>
    <string name="permission_overview_row">%1$s：%2$s</string>
    <string name="permission_overview_not_observed">尚未偵測</string>
    <string name="permission_overview_not_applicable">此 Android 版本不需要</string>
    <string name="permission_overview_denied">已拒絕或未啟用</string>
    <string name="permission_overview_granted">系統已允許</string>
    <string name="permission_overview_off">關閉</string>
    <string name="permission_overview_on">開啟</string>
    <string name="permission_overview_allowed_disconnected">已允許，服務未連線</string>
    <string name="permission_overview_instance_observed">已偵測到服務執行個體；未測試操作</string>
    <string name="permission_overview_stopped">未偵測到服務執行個體</string>
    <string name="permission_overview_microphone">麥克風權限</string>
    <string name="permission_overview_microphone_why">僅在你另行啟動語音時用於錄音。此畫面不會錄音。</string>
    <string name="permission_overview_notification_runtime">通知執行階段權限</string>
    <string name="permission_overview_notifications_why">Android 13 以上在應用程式發送通知前會詢問。更早的版本不需要此提示。</string>
    <string name="permission_overview_notification_delivery">通知已啟用</string>
    <string name="permission_overview_notifications_delivery_why">通知權限與通知啟用是兩個獨立的系統訊號，都不能證明通知已送達。</string>
    <string name="permission_overview_accessibility_os">已允許應用程式無障礙服務</string>
    <string name="permission_overview_accessibility_why">在 Android 設定中啟用此應用程式服務後可輔助控制手機。需由你選擇；此畫面不執行任何操作。</string>
    <string name="permission_overview_accessibility_instance">無障礙服務連線</string>
    <string name="permission_overview_accessibility_instance_why">執行中的執行個體與系統授權分開偵測，不能證明手機操作已成功。</string>
    <string name="permission_overview_overlay_os">已允許顯示在其他應用程式上層</string>
    <string name="permission_overview_overlay_why">用於浮動狀態顯示的選用項目，只用語音時不需要。在 Android 設定中由你決定。</string>
    <string name="permission_overview_overlay_optin">應用程式浮動顯示選項</string>
    <string name="permission_overview_overlay_optin_why">應用程式偏好設定與 Android 浮動視窗權限彼此獨立。此畫面不會開啟它，也不會顯示浮動視窗。</string>
    <string name="permission_overview_handsfree_optin">語音聆聽服務</string>
    <string name="permission_overview_handsfree_why">聆聽服務是否回報自身為啟用中。這不能證明要求或語音回答已成功。</string>
    <string name="permission_overview_control_consent">應用程式控制同意</string>
    <string name="permission_overview_control_why">已儲存的應用程式同意與無障礙授權彼此獨立。此畫面不會變更。</string>
    <string name="permission_overview_mcp_instance">MCP 服務執行個體</string>
    <string name="permission_overview_mcp_why">服務執行個體存在只是生命週期上的觀察，不能證明 MCP 正常運作或已授權。</string>
    <string name="permission_overview_limit">此處不會執行錄音、MCP 指令、無障礙操作或浮動顯示。權限與執行個體存在都不能證明端對端成功。</string>
    <string name="permission_overview_integration">開始引導設定</string>
</resources>
